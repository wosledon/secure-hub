{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SecureHub": {
    "Database": {
      "Provider": "Sqlite",
      "ConnectionString": "Data Source=./data/securehub.db"
    },
    "Security": {
      "RequireHttps": false,
      "AdminBindAddress": "127.0.0.1",
      "AllowSelfRegistration": true
    },
    "Content": {
      "RawRetentionDays": 30,
      "RedactedRetentionDays": 365,
      "CompressedRetentionDays": 365,
      "MaxContentBytes": 262144
    },
    "Guardrails": {
      "TotalBudgetMs": 8,
      "PerDetectorBudgetMs": 2,
      "OnError": "block"
    },
    "Compression": {
      "Enabled": true,
      "MinSavingsRatio": 0.02
    },
    "LoadBalancing": {
      "Enabled": false,
      "AutoGroupSameModel": true,
      "AllowVariantMixing": false,
      "AllowCrossScope": false,
      "Strategy": "priority-weighted",
      "HealthPenalty": 0.5
    }
  }
}
